# GrabOn Deal Distributor — Environment Variables
# Copy this file to mcp-server/.env and fill in your values.

# ─────────────────────────────────────────────────────────
# Required: Your Anthropic API key
# Get one free at https://console.anthropic.com
# ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─────────────────────────────────────────────────────────
# Copy generation mode
# true  = Claude API (genuine AI copy, requires API key)
# false = Built-in template engine (fast, no API key needed)
# ─────────────────────────────────────────────────────────
USE_CLAUDE_API=true

# Webhook server URL (default: local mock server on :3001)
WEBHOOK_BASE_URL=http://localhost:3001

# Frontend API/WebSocket server port
FRONTEND_SERVER_PORT=3002
